# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=*

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/eduwa_quiz

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Admin bootstrap ---
# Seeds the dashboard login via `npm run seed:admin` (add --reset to reapply the password).
ADMIN_BOOTSTRAP_EMAIL=admin@eduwa.app
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password
ADMIN_BOOTSTRAP_NAME=Eduwa Admin

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Eduwa Quiz <no-reply@eduwa.app>

# --- SMS / OTP (Termii) ---
TERMII_API_KEY=

# --- Payments ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- AI Providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_QUIZ_PROVIDER=openai        # openai | gemini
AI_COACH_PROVIDER=openai       # openai | gemini

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
GOOGLE_TTS_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# --- Object Storage (S3-compatible: AWS S3, Cloudflare R2, or Supabase Storage) ---
STORAGE_PROVIDER=s3            # s3 | supabase | r2
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                   # required for R2/Supabase, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_PUBLIC_URL_BASE=            # optional CDN/public base URL override, e.g. https://cdn.eduwa.app

# --- Push Notifications ---
EXPO_ACCESS_TOKEN=

# --- Token economics ---
SIGNUP_BONUS_TOKENS=1000
AI_QUIZ_TOKEN_COST=50
COACH_MESSAGE_TOKEN_COST=10

# --- Notifications / Cron ---
ENABLE_CRON=true
JAMB_EXAM_DATE=2026-04-25       # ISO date (UTC midnight); drives exam countdown alerts

# --- Secrets (NEVER commit these) ---
# .env holds the real MONGODB_URI, JWT secrets, ADMIN_BOOTSTRAP_PASSWORD and
# third-party API keys. Only .env.example (placeholders) belongs in git.
.env
.env.*
!.env.example

# --- Dependencies ---
node_modules/
jspm_packages/
web_modules/
.npm/
.yarn/cache
.yarn/install-state.gz
pnp.*
vendor/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Caches ---
.npm
.cache/
.parcel-cache/
.turbo/
.eslintcache
stylelintcache
*.tsbuildinfo
.temp/
.tmp/
tmp/
temp/

# --- Test / coverage output ---
coverage/
.nyc_output/

# --- Runtime artifacts ---
# Uploads are held in memory by multer, but keep this in case disk storage is
# ever enabled for avatars or generated audio.
uploads/
public/uploads/
*.pid
*.seed
*.pid.lock

# --- Local environment / editor / OS ---
.env.local
.env.*.local
.expo/
.expo-shared/
*.orig.*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
.project
.settings/
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.history/

# --- Build output ---
build/
dist/
out/
.vercel/
.netlify/

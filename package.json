{
  "name": "eduwa-quiz-backend",
  "version": "1.0.0",
  "description": "Backend API for Eduwa Quiz — JAMB prep app (past questions, AI smart quizzes, voice coach, tokens, progress, notifications)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seedSubjects.js",
    "seed:admin": "node src/seed/seedAdmin.js",
    "seed:admin:reset": "node src/seed/seedAdmin.js --reset",
    "seed:questions": "node src/seed/seedQuestions.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "node-cron": "^3.0.3",
    "@aws-sdk/client-s3": "^3.637.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nanoid": "^3.3.7",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
